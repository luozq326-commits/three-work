# 只排除纯机器产物，其余（含 data/、out/、.workbuddy-ai/）全部入库
__pycache__/
*.pyc
.venv/

# 网页界面的上传缓存：运行时产物，源 PDF 在 data/papers/ 里已有
data/uploads/

# MinerU 虚拟环境（1.4GB）与解析产物（每页快照 + 裁图），不入库
.venv-mineru/
data/media/

# 术语库导出（运行时产物）
data/glossary_export.csv

# MinerU 模型（835MB，单个 onnx 591MB，超过 GitHub 100MB 限制）
模型/

# 本机配置（含 API Key，绝不入库；模板见 data/settings.example.json）
data/settings.json
